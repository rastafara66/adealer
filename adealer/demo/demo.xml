            <field name="mileage">62450</field>
            <field name="schedule_date" eval="(DateTime.now() - timedelta(days=20))"/>
            <field name="service_advisor_id" ref="base.user_admin"/>
            <field name="mechanic_ids" eval="[(6,0,[ref('demo_emp_shevchuk'), ref('demo_emp_bondar')])]"/>
            <field name="operations" eval="[
                (0,0,{'product_id': ref('demo_srv_to'), 'product_uom_qty': 1.0, 'price_unit': 79.0}),
                (0,0,{'product_id': ref('demo_prod_oil'), 'product_uom_qty': 4.0, 'price_unit': 11.9}),
                (0,0,{'product_id': ref('demo_prod_oilfilter_a'), 'product_uom_qty': 1.0, 'price_unit': 14.9}),
            ]"/>
        </record>

        <record id="demo_ro_rav4" model="repair.order">
            <field name="partner_id" ref="demo_partner_kovalenko"/>
            <field name="vehicle_id" ref="demo_veh_rav4"/>
            <field name="mileage">38900</field>
            <field name="schedule_date" eval="(DateTime.now() - timedelta(days=5))"/>
