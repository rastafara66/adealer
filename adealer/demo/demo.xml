            <field name="mechanic_ids" eval="[(6,0,[ref('demo_emp_bondar')])]"/>
            <field name="operations" eval="[
                (0,0,{'product_id': ref('demo_srv_brakes'), 'product_uom_qty': 1.0, 'price_unit': 69.0}),
