            <field name="cargo_length_mm">2570</field>
            <field name="cargo_width_mm">1700</field>
            <field name="cargo_height_mm">1410</field>
            <field name="cargo_volume_m3">5.8</field>
            <field name="euro_pallets">2</field>
            <field name="sliding_door">right</field>
            <field name="tail_lift" eval="False"/>
