        <!--  PARTS AND SERVICES (catalogue)                              -->
        <!-- ============================================================ -->
        <!-- Analog group for oil filters -->
        <record id="demo_analog_oilfilter" model="adealer.part.analog.group">
            <field name="name">Oil filter (analogs)</field>
            <field name="note">Interchangeable oil filters from different manufacturers.</field>
        </record>

        <!-- Parts (type=consu) -->
        <record id="demo_prod_oilfilter_a" model="product.product">
            <field name="name">Oil filter OEM-90915</field>
            <field name="type">consu</field>
            <field name="default_code">OF-90915</field>
            <field name="list_price">14.9</field>
            <field name="standard_price">9.4</field>
