            <field name="purchase_price">19400.0</field>
            <field name="sale_price">21900.0</field>
            <field name="currency_id" ref="base.EUR"/>
            <field name="supplier_id" ref="demo_partner_supplier"/>
            <field name="location_note">Yard, row 4</field>
        </record>

        <!-- ============================================================ -->
        <!--  REPAIR ORDERS (workshop)                                    -->
        <!-- ============================================================ -->
        <record id="demo_ro_corolla" model="repair.order">
            <field name="partner_id" ref="demo_partner_ivanenko"/>
