            <field name="operations" eval="[
                (0,0,{'product_id': ref('demo_srv_diag'), 'product_uom_qty': 1.0, 'price_unit': 59.0}),
            ]"/>
        </record>

        <!-- ============================================================ -->
        <!--  CUSTOMER ORDERS (sale.order)                                -->
        <!-- ============================================================ -->
        <record id="demo_so_ivanenko" model="sale.order">
            <field name="partner_id" ref="demo_partner_ivanenko"/>
            <field name="vehicle_id" ref="demo_veh_corolla"/>
            <field name="order_line" eval="[
                (0,0,{'product_id': ref('demo_prod_oil'), 'product_uom_qty': 4.0, 'price_unit': 11.9}),
                (0,0,{'product_id': ref('demo_prod_oilfilter_a'), 'product_uom_qty': 1.0, 'price_unit': 14.9}),
                (0,0,{'product_id': ref('demo_srv_to'), 'product_uom_qty': 1.0, 'price_unit': 79.0}),
            ]"/>
        </record>

        <record id="demo_so_avtoprofi" model="sale.order">
            <field name="partner_id" ref="demo_partner_avtoprofi"/>
            <field name="vehicle_id" ref="demo_veh_passat"/>
            <field name="order_line" eval="[
                (0,0,{'product_id': ref('demo_prod_brakepads'), 'product_uom_qty': 2.0, 'price_unit': 89.0}),
                (0,0,{'product_id': ref('demo_prod_wiper'), 'product_uom_qty': 2.0, 'price_unit': 18.9}),
            ]"/>
        </record>

        <!-- ============================================================ -->
        <!--  SERVICE CAMPAIGN (recall / maintenance)                     -->
        <!-- ============================================================ -->
        <record id="demo_campaign_recall" model="dealer.service.campaign">
            <field name="name">Recall: fuel pump inspection</field>
            <field name="code">RC-2025-07</field>
            <field name="campaign_type">recall</field>
            <field name="state">active</field>
            <field name="service_product_id" ref="demo_srv_diag"/>
            <field name="line_ids" eval="[
                (0,0,{'vehicle_id': ref('demo_veh_corolla'), 'partner_id': ref('demo_partner_ivanenko'), 'state': 'pending'}),
                (0,0,{'vehicle_id': ref('demo_veh_rav4'), 'partner_id': ref('demo_partner_kovalenko'), 'state': 'done'}),
            ]"/>
        </record>

    </data>
</odoo>
