<odoo>
    <record id="ir_cron_adealer_update_check" model="ir.cron">
        <field name="name">3A-dealer: weekly update check</field>
        <field name="model_id" ref="model_adealer_app_update"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_update()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_adealer_send_error_reports" model="ir.cron">
        <field name="name">3A-dealer: send queued error reports</field>
        <field name="model_id" ref="model_adealer_error_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reports()</field>
        <field name="interval_number">4</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <record id="model_fleet_vehicle_import" model="ir.model">
        <field name="name">fleet.vehicle.import</field>
        <field name="model">fleet.vehicle.import</field>
        <field name="state">base</field>
    </record>
    <record id="ir_cron_import_vehicles" model="ir.cron">
        <field name="name">Import vehicles from Excel</field>
        <field name="model_id" ref="adealer.model_fleet_vehicle_import"/>
        <field name="state">code</field>
        <field name="code">model.import_vehicles_from_excel()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
    <record id="model_fleet_vehicle_model_import" model="ir.model">
        <field name="name">fleet.vehicle.model.import</field>
        <field name="model">fleet.vehicle.model.import</field>
        <field name="state">base</field>
    </record>
    <record id="ir_cron_import_vehicle_models" model="ir.cron">
        <field name="name">Import vehicle models from Excel</field>
        <field name="model_id" ref="adealer.model_fleet_vehicle_model_import"/>
        <field name="state">code</field>
        <field name="code">model.import_vehicle_models_from_excel()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
    <record id="model_res_partner_import" model="ir.model">
        <field name="name">res.partner.import</field>
        <field name="model">res.partner.import</field>
        <field name="state">base</field>
    </record>
    <record id="ir_cron_import_partners" model="ir.cron">
        <field name="name">Import partners from Excel</field>
        <field name="model_id" ref="adealer.model_res_partner_import"/>
        <field name="state">code</field>
        <field name="code">model.import_partners_from_excel()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
    <record id="model_res_partner_address_import" model="ir.model">
        <field name="name">res.partner.address.import</field>
        <field name="model">res.partner.address.import</field>
        <field name="state">base</field>
    </record>
    <record id="ir_cron_import_partner_addresses" model="ir.cron">
        <field name="name">Import partner addresses from Excel</field>
        <field name="model_id" ref="adealer.model_res_partner_address_import"/>
        <field name="state">code</field>
        <field name="code">model.import_addresses_from_excel()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">False</field>
    </record>
</odoo>