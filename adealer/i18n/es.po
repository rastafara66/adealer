#: code:addons/adealer/models/partner_import.py:0
msgid ""
"Рядок %(row)s: %(what)s\n"
"    Чому: %(why)s\n"
"    Що зробити: %(howto)s"
msgstr ""
"Fila %(row)s: %(what)s\n"
"    Por qué: %(why)s\n"
"    Qué hacer: %(howto)s"

#. module: adealer
#: model:res.groups,comment:adealer.group_adealer_manager
msgid ""
"Усе, що вміє користувач, плюс довідники,\n"
"            налаштування, імпорти й звіти по взаєморозрахунках."
msgstr ""
"Todo lo que puede el usuario, más los catálogos,\n"
"los ajustes, las importaciones y los informes de cuentas."

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import_wizard.py:0
msgid ""
"Формат файлу не підходить: «%s».\n"
"\n"
"Потрібен Excel — .xls або .xlsx. Якщо файл у CSV, збережіть його як книгу Excel."
msgstr ""
"Formato de archivo no válido: «%s».\n"
"\n"
"Se necesita Excel: .xls o .xlsx. Si el archivo está en CSV, guárdelo como libro de Excel."

#. module: adealer
#: model:res.groups,comment:adealer.group_adealer_user
msgid ""
"Щоденна робота: наряди, записи на сервіс, авто\n"
"            клієнтів, склад авто, кампанії. Без довідників і налаштувань."
msgstr ""
"Trabajo diario: órdenes de reparación, citas, vehículos\n"
"de clientes, stock de vehículos, campañas. Sin catálogos ni ajustes."

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid "додайте хоч один реквізит — інакше контрагента не буде з чим зіставити"
msgstr "añada al menos un dato identificativo; si no, la contraparte no podrá compararse con nada"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid "заповніть колонку «Наименование» або приберіть рядок"
msgstr "rellene la columna «Наименование» o elimine la fila"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid "контрагента без назви створити не можна"
msgstr "no se puede crear una contraparte sin nombre"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid ""
"контрагента створено без коду; виправте код у файлі й повторіть імпорт, або "
"допишіть код у картці"
msgstr "contraparte creada sin código; corrija el código en el archivo y repita la importación, o añádalo en la ficha"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid "немає жодного реквізиту: ні телефону, ні пошти, ні коду, ні адреси"
msgstr "ningún dato identificativo: ni teléfono, ni correo, ni código, ni dirección"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid "немає назви"
msgstr "sin nombre"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/partner_import.py:0
msgid "у файлі «%s»: має бути 8 або 10 цифр"
msgstr "en el archivo «%s»: deben ser 8 o 10 dígitos"

#. module: adealer
#. odoo-python
#: code:addons/adealer/models/service.py:0
msgid "• %(product)s: needed %(need)s, available %(free)s"
msgstr "• %(product)s: necesario %(need)s, disponible %(free)s"
