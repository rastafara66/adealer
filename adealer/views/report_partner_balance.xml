<odoo>
    <record id="view_partner_balance_wizard_form" model="ir.ui.view">
        <field name="name">partner.balance.wizard.form</field>
        <field name="model">partner.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Взаєморозрахунки з контрагентами" class="adealer-report">
                <sheet>
                    <h2 class="adealer-report__title">Взаєморозрахунки з контрагентами</h2>
                    <div class="adealer-report__params">
                        <group col="4">
                            <label for="date_from" string="Період з"/>
                            <div class="o_row adealer-period">
                                <field name="date_from" nolabel="1"/>
                                <span class="mx-1">по</span>
                                <field name="date_to" nolabel="1"/>
                            </div>
                            <field name="partner_id" options="{'no_create': True}"
                                   placeholder="Всі контрагенти"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <button name="action_generate" type="object" string="Сформувати"
                                class="btn-primary mb-2"/>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" edit="0" limit="200"
                              decoration-bf="line_type in ('opening','closing','total')"
                              decoration-info="line_type in ('opening','closing')"
                              decoration-danger="balance &lt; 0">
                            <field name="line_type" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="date" column_invisible="not parent.partner_id"/>
                            <field name="doc_name" string="Документ / Контрагент"/>
                            <field name="opening" column_invisible="parent.partner_id"/>
                            <field name="debit" sum="Разом"/>
                            <field name="credit" sum="Разом"/>
                            <field name="balance"/>
                            <button name="action_open_move" type="object" icon="fa-external-link"
                                    title="Відкрити документ" column_invisible="not parent.partner_id"/>
                            <button name="action_open_partner" type="object" icon="fa-search-plus"
                                    title="Деталізація по контрагенту" column_invisible="parent.partner_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_partner_balance_wizard" model="ir.actions.act_window">
        <field name="name">Взаєморозрахунки з контрагентами</field>
        <field name="res_model">partner.balance.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
