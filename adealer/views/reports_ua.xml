<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!--  РАХУНОК НА ОПЛАТУ (sale.order) — аналог 1С «СчетЗаказ»       -->
        <!-- ============================================================ -->
        <record id="action_report_invoice_pay" model="ir.actions.report">
            <field name="name">Invoice for payment</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_invoice_pay</field>
            <field name="report_file">adealer.report_invoice_pay</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_invoice_pay">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h3 class="text-center">
                                Invoice for payment No. <span t-field="o.name"/>
                                from <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                            </h3>
                            <table class="table table-sm table-borderless mt-2">
                                <tr>
                                    <td style="width:120px"><strong>Supplier:</strong></td>
                                    <td>
                                        <span t-field="o.company_id.name"/>
                                        <t t-if="o.company_id.partner_id.edrpou">, EDRPOU <span t-field="o.company_id.partner_id.edrpou"/></t>
                                        <t t-if="o.company_id.vat">, TIN <span t-field="o.company_id.vat"/></t>
                                    </td>
                                </tr>
                                <tr t-if="o.company_id.partner_id.bank_ids">
                                    <td><strong>Bank account:</strong></td>
                                    <td>
                                        <span t-field="o.company_id.partner_id.bank_ids[0].acc_number"/>
                                        <t t-if="o.company_id.partner_id.bank_ids[0].bank_id"> at <span t-field="o.company_id.partner_id.bank_ids[0].bank_id.name"/></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Buyer:</strong></td>
                                    <td>
                                        <span t-field="o.partner_id.name"/>
                                        <t t-if="o.partner_id.edrpou">, EDRPOU <span t-field="o.partner_id.edrpou"/></t>
                                    </td>
                                </tr>
                                <tr t-if="o.vehicle_id">
                                    <td><strong>Vehicle:</strong></td>
                                    <td><span t-field="o.vehicle_id"/> (VIN <span t-field="o.vehicle_id.vin_sn"/>)</td>
                                </tr>
                            </table>

                            <table class="table table-sm table-bordered mt-2">
                                <thead>
                                    <tr>
                                        <th>№</th>
                                        <th>Product / service</th>
                                        <th class="text-end">Qty</th>
                                        <th>Unit</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.order_line" t-as="l">
                                        <t t-if="not l.display_type">
                                            <td><span t-esc="l_index + 1"/></td>
                                            <td><span t-field="l.product_id"/></td>
                                            <td class="text-end"><span t-field="l.product_uom_qty"/></td>
                                            <td><span t-field="l.product_uom_id.name"/></td>
                                            <td class="text-end"><span t-field="l.price_unit"/></td>
                                            <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="row">
                                <div class="col-7"/>
                                <div class="col-5">
                                    <table class="table table-sm table-borderless">
                                        <tr><td>Total excl. VAT:</td><td class="text-end"><span t-field="o.amount_untaxed" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr>
                                        <tr><td>VAT:</td><td class="text-end"><span t-field="o.amount_tax" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr>
                                        <tr><td><strong>Total due:</strong></td><td class="text-end"><strong><span t-field="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></strong></td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="row mt-5">
                                <div class="col-6">Issued by: _______________</div>
                                <div class="col-6 text-end">L.S.</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  ВИДАТКОВА НАКЛАДНА (account.move) — аналог 1С «Накладная»    -->
        <!-- ============================================================ -->
        <record id="action_report_vydatkova" model="ir.actions.report">
            <field name="name">Delivery note</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_vydatkova</field>
            <field name="report_file">adealer.report_vydatkova</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_vydatkova">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h3 class="text-center">
                                Delivery note No. <span t-field="o.name"/>
                                from <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                            </h3>
                            <table class="table table-sm table-borderless mt-2">
                                <tr>
                                    <td style="width:130px"><strong>Supplier:</strong></td>
                                    <td>
                                        <span t-field="o.company_id.name"/>
                                        <t t-if="o.company_id.partner_id.edrpou">, EDRPOU <span t-field="o.company_id.partner_id.edrpou"/></t>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Recipient:</strong></td>
                                    <td>
                                        <span t-field="o.partner_id.name"/>
                                        <t t-if="o.partner_id.edrpou">, EDRPOU <span t-field="o.partner_id.edrpou"/></t>
                                    </td>
                                </tr>
                                <tr t-if="o.invoice_origin">
                                    <td><strong>Basis:</strong></td>
                                    <td><span t-field="o.invoice_origin"/></td>
                                </tr>
                            </table>

                            <table class="table table-sm table-bordered mt-2">
                                <thead>
                                    <tr>
                                        <th>№</th>
                                        <th>Product / service</th>
                                        <th class="text-end">Qty</th>
                                        <th>Unit</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.invoice_line_ids" t-as="l">
                                        <t t-if="l.display_type == 'product'">
                                            <td><span t-esc="l_index + 1"/></td>
                                            <td><span t-field="l.product_id"/></td>
                                            <td class="text-end"><span t-field="l.quantity"/></td>
                                            <td><span t-field="l.product_uom_id.name"/></td>
                                            <td class="text-end"><span t-field="l.price_unit"/></td>
                                            <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="row">
                                <div class="col-7"/>
                                <div class="col-5">
                                    <table class="table table-sm table-borderless">
                                        <tr><td>Total excl. VAT:</td><td class="text-end"><span t-field="o.amount_untaxed" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr>
                                        <tr><td>VAT:</td><td class="text-end"><span t-field="o.amount_tax" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></td></tr>
                                        <tr><td><strong>Total:</strong></td><td class="text-end"><strong><span t-field="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></strong></td></tr>
                                    </table>
                                </div>
                            </div>
                            <div class="row mt-5">
                                <div class="col-6">Released by: _______________</div>
                                <div class="col-6 text-end">Received by: _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  ПОВЕРНЕННЯ ВІД ПОКУПЦЯ (account.move out_refund)             -->
        <!-- ============================================================ -->
        <record id="action_report_povernennia" model="ir.actions.report">
            <field name="name">Return note</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_povernennia</field>
            <field name="report_file">adealer.report_povernennia</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_povernennia">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h3 class="text-center">
                                Return note No. <span t-field="o.name"/>
                                from <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                            </h3>
                            <table class="table table-sm table-borderless mt-2">
                                <tr><td style="width:150px"><strong>Recipient (from):</strong></td>
                                    <td><span t-field="o.partner_id.name"/><t t-if="o.partner_id.edrpou">, EDRPOU <span t-field="o.partner_id.edrpou"/></t></td></tr>
                                <tr><td><strong>Supplier (to):</strong></td>
                                    <td><span t-field="o.company_id.name"/><t t-if="o.company_id.partner_id.edrpou">, EDRPOU <span t-field="o.company_id.partner_id.edrpou"/></t></td></tr>
                                <tr t-if="o.invoice_origin"><td><strong>Basis:</strong></td><td><span t-field="o.invoice_origin"/></td></tr>
                            </table>
                            <table class="table table-sm table-bordered mt-2">
                                <thead><tr><th>№</th><th>Product / service</th><th class="text-end">Qty</th><th>Unit</th><th class="text-end">Price</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.invoice_line_ids" t-as="l">
                                        <t t-if="l.display_type == 'product'">
                                            <td><span t-esc="l_index + 1"/></td>
                                            <td><span t-field="l.product_id"/></td>
                                            <td class="text-end"><span t-field="l.quantity"/></td>
                                            <td><span t-field="l.product_uom_id.name"/></td>
                                            <td class="text-end"><span t-field="l.price_unit"/></td>
                                            <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="text-end"><strong>Total: <span t-field="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></strong></p>
                            <div class="row mt-5">
                                <div class="col-6">Returned by: _______________</div>
                                <div class="col-6 text-end">Accepted by: _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  ПРИБУТКОВА НАКЛАДНА / НАДХОДЖЕННЯ (account.move in_invoice)  -->
        <!-- ============================================================ -->
        <record id="action_report_nadhodzhennia" model="ir.actions.report">
            <field name="name">Goods-receipt note</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_nadhodzhennia</field>
            <field name="report_file">adealer.report_nadhodzhennia</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_nadhodzhennia">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h3 class="text-center">
                                Goods-receipt note No. <span t-field="o.name"/>
                                from <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                            </h3>
                            <table class="table table-sm table-borderless mt-2">
                                <tr><td style="width:130px"><strong>Supplier:</strong></td>
                                    <td><span t-field="o.partner_id.name"/><t t-if="o.partner_id.edrpou">, EDRPOU <span t-field="o.partner_id.edrpou"/></t></td></tr>
                                <tr><td><strong>Recipient:</strong></td>
                                    <td><span t-field="o.company_id.name"/><t t-if="o.company_id.partner_id.edrpou">, EDRPOU <span t-field="o.company_id.partner_id.edrpou"/></t></td></tr>
                                <tr t-if="o.ref"><td><strong>Supplier doc.:</strong></td><td><span t-field="o.ref"/></td></tr>
                            </table>
                            <table class="table table-sm table-bordered mt-2">
                                <thead><tr><th>№</th><th>Product / service</th><th class="text-end">Qty</th><th>Unit</th><th class="text-end">Price</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.invoice_line_ids" t-as="l">
                                        <t t-if="l.display_type == 'product'">
                                            <td><span t-esc="l_index + 1"/></td>
                                            <td><span t-field="l.product_id"/></td>
                                            <td class="text-end"><span t-field="l.quantity"/></td>
                                            <td><span t-field="l.product_uom_id.name"/></td>
                                            <td class="text-end"><span t-field="l.price_unit"/></td>
                                            <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="text-end"><strong>Total: <span t-field="o.amount_total" t-options='{"widget":"monetary","display_currency":o.currency_id}'/></strong></p>
                            <div class="row mt-5">
                                <div class="col-6">Handed over by: _______________</div>
                                <div class="col-6 text-end">Accepted by: _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  ДОВІРЕНІСТЬ (purchase.order) — спрощена М-2                  -->
        <!-- ============================================================ -->
        <record id="action_report_dovirenist" model="ir.actions.report">
            <field name="name">Power of attorney</field>
            <field name="model">purchase.order</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_dovirenist</field>
            <field name="report_file">adealer.report_dovirenist</field>
            <field name="binding_model_id" ref="purchase.model_purchase_order"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_dovirenist">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h3 class="text-center">Power of attorney No. <span t-field="o.name"/></h3>
                            <p class="mt-2">
                                Company <strong><span t-field="o.company_id.name"/></strong>
                                <t t-if="o.company_id.partner_id.edrpou">(EDRPOU <span t-field="o.company_id.partner_id.edrpou"/>)</t>
                                instructs to receive from the supplier
                                <strong><span t-field="o.partner_id.name"/></strong>
                                per order <span t-field="o.name"/> the following inventory items:
                            </p>
                            <table class="table table-sm table-bordered mt-2">
                                <thead><tr><th>№</th><th>Name</th><th class="text-end">Qty</th><th>Unit</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="o.order_line" t-as="l">
                                        <t t-if="not l.display_type">
                                            <td><span t-esc="l_index + 1"/></td>
                                            <td><span t-field="l.product_id"/></td>
                                            <td class="text-end"><span t-field="l.product_qty"/></td>
                                            <td><span t-field="l.product_uom_id.name"/></td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="mt-3">Authorized person: _______________________ (position, full name)</p>
                            <p>Signature of the authorized person: _______________ we certify.</p>
                            <div class="row mt-4">
                                <div class="col-6">Manager: _______________</div>
                                <div class="col-6 text-end">Chief accountant: _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  АКТ ЗВІРКИ ВЗАЄМОРОЗРАХУНКІВ (res.partner)                   -->
        <!-- ============================================================ -->
        <record id="action_report_akt_zvirky" model="ir.actions.report">
            <field name="name">Reconciliation act</field>
            <field name="model">res.partner</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_akt_zvirky</field>
            <field name="report_file">adealer.report_akt_zvirky</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_type">report</field>
        </record>
        <template id="report_akt_zvirky">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <t t-set="comp" t-value="o.get_report_company()"/>
                            <h3 class="text-center">Reconciliation act</h3>
                            <p class="mt-2">
                                between <strong><span t-esc="comp.name"/></strong>
                                and <strong><span t-field="o.name"/></strong>
                                <t t-if="o.edrpou">(EDRPOU <span t-field="o.edrpou"/>)</t>
                            </p>
                            <t t-set="rows" t-value="o.get_reconciliation_lines()"/>
                            <table class="table table-sm table-bordered mt-2">
                                <thead><tr><th>Date</th><th>Document</th><th class="text-end">Debit</th><th class="text-end">Credit</th><th class="text-end">Balance</th></tr></thead>
                                <tbody>
                                    <tr t-foreach="rows" t-as="r">
                                        <td><span t-esc="r['date']" t-options='{"widget": "date"}'/></td>
                                        <td><span t-esc="r['name']"/></td>
                                        <td class="text-end"><span t-esc="r['debit']" t-options='{"widget":"monetary","display_currency":comp.currency_id}'/></td>
                                        <td class="text-end"><span t-esc="r['credit']" t-options='{"widget":"monetary","display_currency":comp.currency_id}'/></td>
                                        <td class="text-end"><span t-esc="r['balance']" t-options='{"widget":"monetary","display_currency":comp.currency_id}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <p t-if="not rows" class="text-muted">No posted receivables.</p>
                            <p class="mt-2">
                                Closing balance:
                                <strong><span t-esc="rows[-1]['balance'] if rows else 0.0" t-options='{"widget":"monetary","display_currency":comp.currency_id}'/></strong>
                                (positive — the counterparty owes us).
                            </p>
                            <div class="row mt-5">
                                <div class="col-6">From <span t-esc="comp.name"/>: _______________</div>
                                <div class="col-6 text-end">From <span t-field="o.name"/>: _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
