<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============================================================ -->
        <!--  НАРЯД-ЗАМОВЛЕННЯ (repair.order)                             -->
        <!-- ============================================================ -->
        <record id="action_report_repair_order" model="ir.actions.report">
            <field name="name">Repair order</field>
            <field name="model">repair.order</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_repair_order</field>
            <field name="report_file">adealer.report_repair_order</field>
            <field name="binding_model_id" ref="repair.model_repair_order"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_repair_order">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h2 class="text-center">
                                Repair order No. <span t-field="o.name"/>
                            </h2>
                            <div class="row mt-3">
                                <div class="col-6">
                                    <strong>Customer:</strong> <span t-field="o.partner_id"/><br/>
                                    <strong>Vehicle:</strong> <span t-field="o.vehicle_id"/><br/>
                                    <strong>VIN:</strong> <span t-field="o.vehicle_id.vin_sn"/><br/>
                                    <strong>Mileage:</strong> <span t-field="o.mileage"/> km
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Date:</strong> <span t-field="o.create_date" t-options='{"widget": "date"}'/><br/>
                                    <strong>Advisor:</strong> <span t-field="o.service_advisor_id"/><br/>
                                    <strong>Mechanics:</strong>
                                    <span t-foreach="o.mechanic_ids" t-as="mch">
                                        <span t-field="mch.name"/><t t-if="not mch_last">, </t>
                                    </span><br/>
                                    <strong>Stage:</strong> <span t-field="o.stage_id"/>
                                </div>
                            </div>

                            <h4 class="mt-4">Works (services)</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-end">Std hr</th>
                                        <th class="text-end">Price per std hr</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.service_line_ids" t-as="l">
                                        <td><span t-field="l.product_id"/></td>
                                        <td class="text-end"><span t-field="l.normo_hours"/></td>
                                        <td class="text-end"><span t-field="l.price_unit"/></td>
                                        <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <h4 class="mt-3">Parts (materials)</h4>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.part_line_ids" t-as="l">
                                        <td><span t-field="l.product_id"/></td>
                                        <td class="text-end"><span t-field="l.product_uom_qty"/></td>
                                        <td class="text-end"><span t-field="l.price_unit"/></td>
                                        <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="row mt-3">
                                <div class="col-6">
                                    Total standard hours: <strong><span t-field="o.total_normo_hours"/></strong>
                                </div>
                                <div class="col-6 text-end">
                                    <strong>Total due:
                                        <span t-field="o.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </strong>
                                </div>
                            </div>

                            <div class="row mt-5">
                                <div class="col-6">Customer: _______________</div>
                                <div class="col-6 text-end">Performer: _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  АКТ ВИКОНАНИХ РОБІТ (repair.order, послуги)                 -->
        <!-- ============================================================ -->
        <record id="action_report_repair_act" model="ir.actions.report">
            <field name="name">Act of completed works</field>
            <field name="model">repair.order</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_repair_act</field>
            <field name="report_file">adealer.report_repair_act</field>
            <field name="binding_model_id" ref="repair.model_repair_order"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_repair_act">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h2 class="text-center">
                                Act of completed works No. <span t-field="o.name"/>
                            </h2>
                            <p class="mt-3">
                                Performer <strong><span t-field="o.company_id.name"/></strong>
                                and the customer <strong><span t-field="o.partner_id"/></strong>
                                have drawn up this act stating that for the vehicle
                                <span t-field="o.vehicle_id"/> (VIN <span t-field="o.vehicle_id.vin_sn"/>) the following work was performed:
                            </p>
                            <table class="table table-sm table-bordered">
                                <thead>
                                    <tr>
                                        <th>№</th>
                                        <th>Work name</th>
                                        <th class="text-end">Quantity</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.service_line_ids" t-as="l">
                                        <td><span t-esc="l_index + 1"/></td>
                                        <td><span t-field="l.product_id"/></td>
                                        <td class="text-end"><span t-field="l.product_uom_qty"/></td>
                                        <td class="text-end"><span t-field="l.price_unit"/></td>
                                        <td class="text-end"><span t-field="l.price_subtotal"/></td>
                                    </tr>
                                </tbody>
                            </table>
                            <p class="text-end">
                                <strong>Total:
                                    <span t-field="o.amount_total"
                                          t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </strong>
                            </p>
                            <p class="mt-2">The works were carried out in full. The customer has no claims.</p>
                            <div class="row mt-5">
                                <div class="col-6">Handed over (performer): _______________</div>
                                <div class="col-6 text-end">Accepted by (customer): _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- ============================================================ -->
        <!--  АКТ ПРИЙОМУ-ПЕРЕДАЧІ АВТОМОБІЛЯ (dealer.car)                -->
        <!-- ============================================================ -->
        <record id="action_report_car_handover" model="ir.actions.report">
            <field name="name">Vehicle handover act</field>
            <field name="model">dealer.car</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">adealer.report_car_handover</field>
            <field name="report_file">adealer.report_car_handover</field>
            <field name="binding_model_id" ref="model_dealer_car"/>
            <field name="binding_type">report</field>
        </record>

        <template id="report_car_handover">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page o_adealer_report">
                            <h2 class="text-center">Vehicle handover act</h2>
                            <p class="mt-3">
                                Seller <strong><span t-field="o.company_id.name"/></strong>
                                handed over, and the buyer <strong><span t-field="o.partner_id"/></strong>
                                accepted the vehicle:
                            </p>
                            <table class="table table-sm table-bordered">
                                <tr><td>Brand/Model</td><td><span t-field="o.model_id"/></td></tr>
                                <tr><td>VIN</td><td><span t-field="o.vin"/></td></tr>
                                <tr><td>Trim / configuration</td><td><span t-field="o.complectation_id"/></td></tr>
                                <tr><td>Color</td><td><span t-field="o.color_id"/></td></tr>
                                <tr><td>Model year</td><td><span t-field="o.model_year"/></td></tr>
                                <tr><td>Engine displacement, cc</td><td><span t-field="o.engine_volume"/></td></tr>
                                <tr>
                                    <td>Total due</td>
                                    <td>
                                        <span t-field="o.total_price"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                            <p class="mt-2">
                                Vehicle inspected, completeness checked. No claims on
                                technical condition or completeness.
                            </p>
                            <div class="row mt-5">
                                <div class="col-6">Handed over (seller): _______________</div>
                                <div class="col-6 text-end">Accepted by (buyer): _______________</div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
