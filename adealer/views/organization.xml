<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Organization: list + form -->
    <record id="view_dealer_organization_list" model="ir.ui.view">
        <field name="name">dealer.organization.list</field>
        <field name="model">dealer.organization</field>
        <field name="arch" type="xml">
            <list string="Organizations">
                <field name="name"/>
                <field name="full_name"/>
                <field name="edrpou"/>
                <field name="vat_code"/>
                <field name="is_vat_payer"/>
                <field name="prefix"/>
                <field name="is_default"/>
            </list>
        </field>
    </record>

    <record id="view_dealer_organization_form" model="ir.ui.view">
        <field name="name">dealer.organization.form</field>
        <field name="model">dealer.organization</field>
        <field name="arch" type="xml">
            <form string="Organization">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="full_name"/>
                            <field name="prefix"/>
                            <field name="is_default"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="edrpou"/>
                            <field name="vat_code"/>
                            <field name="is_vat_payer"/>
                            <field name="vat_certificate" invisible="not is_vat_payer"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dealer_organization" model="ir.actions.act_window">
        <field name="name">Organizations</field>
        <field name="res_model">dealer.organization</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first organization</p>
            <p>Legal entities you operate. Documents default to the one marked as default.</p>
        </field>
    </record>

    <menuitem name="Organizations" id="menu_dealer_organization"
              parent="adealer.configuration"
              action="action_dealer_organization" sequence="5"/>

    <!-- organization_id on operational documents -->
    <record id="view_sale_order_form_org" model="ir.ui.view">
        <field name="name">sale.order.form.org</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="organization_id"/>
            </field>
        </field>
    </record>

    <record id="view_repair_order_form_org" model="ir.ui.view">
        <field name="name">repair.order.form.org</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="organization_id"/>
            </field>
        </field>
    </record>

    <record id="view_move_form_org" model="ir.ui.view">
        <field name="name">account.move.form.org</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="organization_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_order_form_org" model="ir.ui.view">
        <field name="name">purchase.order.form.org</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="organization_id"/>
            </field>
        </field>
    </record>
</odoo>
