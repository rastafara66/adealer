<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Смарт-кнопка «Історія обслуговування» + блок ТО на картці авто -->
        <record id="view_fleet_vehicle_form_service" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.service.history</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_repair_history" type="object"
                            class="oe_stat_button" icon="fa-wrench"
                            invisible="repair_order_count == 0">
                        <field name="repair_order_count" widget="statinfo" string="Repair orders"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='model_id']" position="after">
                    <field name="last_service_date" readonly="1"/>
                    <field name="last_service_mileage" readonly="1"/>
                    <field name="service_interval_months"/>
                    <field name="next_service_date" readonly="1"
                           decoration-danger="service_due"/>
                    <field name="service_due" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Список авто, у яких ТО настало/наближається -->
        <record id="view_fleet_vehicle_service_due_list" model="ir.ui.view">
            <field name="name">fleet.vehicle.service.due.list</field>
            <field name="model">fleet.vehicle</field>
            <field name="arch" type="xml">
                <tree string="Maintenance reminders" decoration-danger="service_due">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="last_service_date"/>
                    <field name="next_service_date"/>
                    <field name="service_due" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="action_service_reminders" model="ir.actions.act_window">
            <field name="name">Maintenance reminders</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_fleet_vehicle_service_due_list"/>
            <field name="domain">[('service_due', '=', True)]</field>
        </record>

        <menuitem name="Maintenance reminders" id="menu_service_reminders"
                  parent="adealer.menu_maintenance"
                  action="action_service_reminders" sequence="49"/>
    </data>
</odoo>
