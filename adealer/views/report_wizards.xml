    <!-- Продажі -->
    <record id="view_report_ready_sales" model="ir.ui.view">
        <field name="name">adealer.report.ready.sales</field>
        <field name="model">adealer.report.wizard</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Продажі" class="adealer-report">
                <sheet>
                    <h2 class="adealer-report__title">Продажі</h2>
                    <div class="adealer-report__params">
                        <group col="4">
                            <field name="report_type" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <label for="date_from" string="Період з"/>
                            <div class="o_row adealer-period">
                                <field name="date_from" nolabel="1"/>
                                <span class="mx-1">по</span>
                                <field name="date_to" nolabel="1"/>
                            </div>
                            <field name="partner_id" string="Клієнт" options="{'no_create': True}" placeholder="Всі"/>
                            <field name="product_id" options="{'no_create': True}" placeholder="Всі"/>
                        </group>
                        <button name="action_generate" type="object" string="Сформувати" class="btn-primary mb-2"/>
                    </div>
                    <field name="line_ids" nolabel="1">
                        <list create="0" delete="0" edit="0" limit="200"
                              decoration-bf="line_type == 'total'">
                            <field name="line_type" column_invisible="1"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="res_id" column_invisible="1"/>
                            <field name="date"/>
                            <field name="name" string="Документ"/>
                            <field name="ref2" string="Клієнт"/>
                            <field name="ref3" string="Товар"/>
                            <field name="qty" sum="Разом"/>
                            <field name="amount" string="Сума" sum="Разом"/>
                            <button name="action_open" type="object" icon="fa-external-link"
                                    title="Відкрити документ" invisible="not res_id"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

