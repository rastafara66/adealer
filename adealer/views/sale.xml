<odoo>
    <data>
        <!--View Sale Order Form with Vehicle-->
        <record model="ir.ui.view" id="adealer.sale_view_order_form_inherit">
            <field name="name">sale.view.order.form.inherit.3A</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="vehicle_id"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_repair_orders" type="object"
                            class="oe_stat_button" icon="fa-wrench"
                            invisible="own_repair_order_count == 0">
                        <field name="own_repair_order_count" widget="statinfo" string="Repair orders"/>
                    </button>
                </xpath>
                <xpath expr="//button[@name='action_confirm']" position="after">
                    <button name="action_create_repair_order" type="object"
                            string="Create order" class="btn-secondary"
                            invisible="state not in ('sale', 'done')"/>
                </xpath>

                <!-- A sale.order here is the customer's order TO US (car brought in
                     for service), never an outgoing quotation we email out. The core
                     form is built around the quotation flow, which read as if we were
                     about to send the customer an offer. Strip that flow out. -->
                <!-- Odoo 18 calls these buttons `send_by_email*`; 19.0 renamed them
                     to `quotation_send*`. Same buttons, same purpose. -->
                <xpath expr="//button[@id='send_by_email_primary']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@id='send_by_email']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@id='send_proforma_primary']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@id='send_proforma']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_preview_sale_order']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- "Valid until" only means anything for an offer we issued -->
                <xpath expr="//field[@name='validity_date']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!-- drop the "Quotation Sent" step from the pipeline -->
                <xpath expr="//field[@name='state'][@widget='statusbar']" position="attributes">
                    <attribute name="statusbar_visible">draft,sale</attribute>
                </xpath>
            </field>
        </record>

        <!-- Sale kanban: show vehicle logo + name -->
        <record model="ir.ui.view" id="adealer.view_sale_order_kanban_inherit">
            <field name="name">sale.order.kanban.inherit.3A</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sale_order_kanban"/>
            <field name="arch" type="xml">
                <!-- 🔴 Канбан у Odoo 17 побудований інакше, ніж у 18/19: <footer>
                     тут немає, а партнер і номер виводяться через t-out, не полями.
                     Причому xpath //field[@name='partner_id'] у 17-й ВСЕ ОДНО
                     знаходиться - але в блоці ОГОЛОШЕННЯ полів угорі картки, тож
                     логотип не впав би з помилкою, а просто ніде не намалювався.
                     Ціль інша, намір той самий. -->
                <xpath expr="//div[hasclass('o_kanban_record_headings')]" position="before">
                    <field name="vehicle_logo" widget="image" class="me-2" options="{'size': [36, 36]}"/>
                </xpath>
                <xpath expr="//div[hasclass('oe_kanban_bottom_left')]/span" position="inside">
                    <field name="vehicle_id"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>