<odoo>
    <data>
        <!-- ===== Журнальні списки документів (стиль 1С) ===== -->

        <!-- Order-наряди (repair.order) — аналог журналу ЗаказНаряд у 1С -->
        <record id="view_repair_order_journal_list" model="ir.ui.view">
            <field name="name">repair.order.journal.list.adealer</field>
            <field name="model">repair.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <tree string="Repair order" default_order="schedule_date desc, name desc" create="1">
                    <field name="schedule_date" string="Date" widget="date"/>
                    <field name="name" string="Number"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="vehicle_id" string="Vehicle" optional="show"/>
                    <field name="amount_total" string="Amount" sum="Total"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="user_id" string="Responsible" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-info="state in ('draft','confirmed')"
                           decoration-warning="state == 'under_repair'"
                           decoration-success="state == 'done'"
                           decoration-muted="state == 'cancel'"/>
                </tree>
            </field>
        </record>

        <!-- Sale orders (sale.order) -->
        <record id="view_sale_order_journal_list" model="ir.ui.view">
            <field name="name">sale.order.journal.list.adealer</field>
            <field name="model">sale.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <tree string="Sale orders" default_order="date_order desc, name desc" create="1">
                    <field name="date_order" string="Date" widget="date"/>
                    <field name="name" string="Number"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="vehicle_id" string="Vehicle" optional="show"/>
                    <field name="client_order_ref" string="Ext. ref." optional="hide"/>
                    <field name="amount_total" string="Amount" sum="Total"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="user_id" string="Responsible" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'sent'"
                           decoration-success="state == 'sale'"
                           decoration-muted="state == 'cancel'"/>
                </tree>
            </field>
        </record>

        <!-- Реалізації / Видаткові (account.move out_invoice) — аналог журналу РеализацияТоваровУслуг у 1С -->
        <record id="view_account_move_realiz_list" model="ir.ui.view">
            <field name="name">account.move.realiz.list.adealer</field>
            <field name="model">account.move</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <tree string="Sales invoices" default_order="invoice_date desc, name desc" create="1">
                    <field name="invoice_date" string="Date" widget="date"/>
                    <field name="name" string="Number"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="ref" string="Ext. ref." optional="show"/>
                    <field name="dealer_car_count" column_invisible="1"/>
                    <field name="is_vehicle_sale" string="Vehicle" widget="boolean_toggle"
                           optional="show" readonly="1"/>
                    <field name="amount_total" string="Amount" sum="Total"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="invoice_user_id" string="Responsible" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-success="state == 'posted'"
                           decoration-muted="state == 'cancel'"/>
                    <field name="payment_state" string="Payment" widget="badge" optional="show"
                           decoration-success="payment_state in ('paid','in_payment')"
                           decoration-warning="payment_state == 'partial'"
                           decoration-danger="payment_state == 'not_paid'"/>
                </tree>
            </field>
        </record>

        <!-- Purchase orders (purchase.order) -->
        <record id="view_purchase_order_journal_list" model="ir.ui.view">
            <field name="name">purchase.order.journal.list.adealer</field>
            <field name="model">purchase.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <tree string="Purchase orders" default_order="date_order desc, name desc" create="1">
                    <field name="date_order" string="Date" widget="date"/>
                    <field name="name" string="Number"/>
                    <field name="partner_id" string="Supplier"/>
                    <field name="partner_ref" string="Ext. ref." optional="hide"/>
                    <field name="amount_total" string="Amount" sum="Total"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="user_id" string="Responsible" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Status" widget="badge"
                           decoration-info="state in ('draft','sent')"
                           decoration-success="state == 'purchase'"
                           decoration-muted="state == 'cancel'"/>
                </tree>
            </field>
        </record>
        <!-- Картка товару (канбан у класичному стилі, без зображення) -->
        <record id="view_product_card_kanban" model="ir.ui.view">
            <field name="name">product.product.card.kanban.adealer</field>
            <field name="model">product.product</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <kanban sample="1" default_order="default_code, name, id">
                    <field name="default_code"/>
                    <field name="name"/>
                    <field name="list_price"/>
                    <field name="standard_price"/>
                    <field name="qty_available"/>
                    <field name="uom_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex mb-1 fw-bold">
                                <field name="name"/>
                            </div>
                            <span t-if="record.default_code.value" class="text-muted">[<field name="default_code"/>]</span>
                            <div class="d-flex justify-content-between mt-2">
                                <span>Price: <field name="list_price"/></span>
                                <span class="text-muted">Cost: <field name="standard_price"/></span>
                            </div>
                            <div class="mt-1">
                                <span>On hand: <field name="qty_available"/> <field name="uom_id"/></span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- Календар нарядів (обслуговування) -->
        <record id="view_repair_order_calendar" model="ir.ui.view">
            <field name="name">repair.order.calendar.adealer</field>
            <field name="model">repair.order</field>
            <field name="arch" type="xml">
                <calendar string="Service calendar" date_start="schedule_date"
                          color="partner_id" mode="month" quick_create="0">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="vehicle_id"/>
                </calendar>
            </field>
        </record>
    </data>
</odoo>
