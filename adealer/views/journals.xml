<odoo>
    <data>
        <!-- ===== Журнальні списки документів (стиль 1С) ===== -->

        <!-- Замовлення-наряди (repair.order) — аналог журналу ЗаказНаряд у 1С -->
        <record id="view_repair_order_journal_list" model="ir.ui.view">
            <field name="name">repair.order.journal.list.adealer</field>
            <field name="model">repair.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <list string="Наряд-замовлення" default_order="schedule_date desc, name desc" create="1">
                    <field name="schedule_date" string="Дата" widget="date"/>
                    <field name="name" string="Номер"/>
                    <field name="partner_id" string="Клієнт"/>
                    <field name="vehicle_id" string="Автомобіль" optional="show"/>
                    <field name="amount_total" string="Сума" sum="Разом"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="user_id" string="Відповідальний" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Статус" widget="badge"
                           decoration-info="state in ('draft','confirmed')"
                           decoration-warning="state == 'under_repair'"
                           decoration-success="state == 'done'"
                           decoration-muted="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <!-- Замовлення покупців (sale.order) -->
        <record id="view_sale_order_journal_list" model="ir.ui.view">
            <field name="name">sale.order.journal.list.adealer</field>
            <field name="model">sale.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <list string="Замовлення покупців" default_order="date_order desc, name desc" create="1">
                    <field name="date_order" string="Дата" widget="date"/>
                    <field name="name" string="Номер"/>
                    <field name="partner_id" string="Клієнт"/>
                    <field name="vehicle_id" string="Автомобіль" optional="show"/>
                    <field name="client_order_ref" string="Реф. 1С" optional="hide"/>
                    <field name="amount_total" string="Сума" sum="Разом"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="user_id" string="Відповідальний" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Статус" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state == 'sent'"
                           decoration-success="state == 'sale'"
                           decoration-muted="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <!-- Замовлення постачальникам (purchase.order) -->
        <record id="view_purchase_order_journal_list" model="ir.ui.view">
            <field name="name">purchase.order.journal.list.adealer</field>
            <field name="model">purchase.order</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <list string="Замовлення постачальникам" default_order="date_order desc, name desc" create="1">
                    <field name="date_order" string="Дата" widget="date"/>
                    <field name="name" string="Номер"/>
                    <field name="partner_id" string="Постачальник"/>
                    <field name="partner_ref" string="Реф. 1С" optional="hide"/>
                    <field name="amount_total" string="Сума" sum="Разом"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="user_id" string="Відповідальний" widget="many2one_avatar_user" optional="hide"/>
                    <field name="state" string="Статус" widget="badge"
                           decoration-info="state in ('draft','sent')"
                           decoration-success="state == 'purchase'"
                           decoration-muted="state == 'cancel'"/>
                </list>
            </field>
        </record>
        <!-- Картка товару (канбан у стилі 1С, без зображення) -->
        <record id="view_product_card_kanban" model="ir.ui.view">
            <field name="name">product.product.card.kanban.adealer</field>
            <field name="model">product.product</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <kanban sample="1" default_order="default_code, name, id">
                    <field name="default_code"/>
                    <field name="name"/>
                    <field name="list_price"/>
                    <field name="standard_price"/>
                    <field name="qty_available"/>
                    <field name="uom_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex mb-1 fw-bold">
                                <field name="name"/>
                            </div>
                            <span t-if="record.default_code.value" class="text-muted">[<field name="default_code"/>]</span>
                            <div class="d-flex justify-content-between mt-2">
                                <span>Ціна: <field name="list_price"/></span>
                                <span class="text-muted">Собівартість: <field name="standard_price"/></span>
                            </div>
                            <div class="mt-1">
                                <span>Залишок: <field name="qty_available"/> <field name="uom_id"/></span>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!-- Календар нарядів (обслуговування) -->
        <record id="view_repair_order_calendar" model="ir.ui.view">
            <field name="name">repair.order.calendar.adealer</field>
            <field name="model">repair.order</field>
            <field name="arch" type="xml">
                <calendar string="Календар обслуговування" date_start="schedule_date"
                          color="partner_id" mode="month" quick_create="0">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="vehicle_id"/>
                </calendar>
            </field>
        </record>
    </data>
</odoo>
