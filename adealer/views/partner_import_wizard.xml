<odoo>
    <record id="view_partner_import_wizard_form" model="ir.ui.view">
        <field name="name">partner.import.wizard.form</field>
        <field name="model">partner.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import partners from Excel">
                <group>
                    <field name="file" filename="file_name" placeholder="Select an Excel file to import"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <footer>
                    <button name="action_import_partners" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_partner_import_wizard" model="ir.actions.act_window">
        <field name="name">Import partners</field>
        <field name="res_model">partner.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>