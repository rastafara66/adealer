<odoo>
    <record id="view_partner_form_inherit_edrpou" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.edrpou</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <!-- `is_company`, а не `company_type`: в Odoo 20 поля company_type немає
                     (той самий вигляд у 18/19/20). Код ЄДРПОУ / РНОКПП — для кожної картки контрагента, і
                     юрособи, і фізособи; в Odoo 20 код — це сам податковий номер (`vat`), тож другий раз його
                     не показуємо (models/ua_tax_ids.py). -->
                <field name="ua_code_in_vat" invisible="1"/>
                <field name="edrpou" invisible="ua_code_in_vat or parent_id"/>
                <field name="driver_license" invisible="is_company"/>
            </xpath>
            
            <xpath expr="//notebook" position="inside">
                <page string="Partner contacts" name="partner_contacts_tab">
                    <field name="partners_contacts">
                        <list string="Partner contacts">
                            <field name="display_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            </list>
                    </field>
                </page>
            </xpath>

            <xpath expr="//page[@name='partner_contacts_tab']" position="after">
                <page string="Partner vehicles" name="partner_vehicles_tab">
                    <field name="partner_vehicles">
                        <list string="Partner vehicles">
                            <field name="name"/>
                            <field name="license_plate"/>
                            <field name="drive_type"/>
                            <field name="transmission"/>
                            </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>