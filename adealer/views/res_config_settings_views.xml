<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.adealer</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="3A-dealer" string="3A-dealer" name="adealer">
                        <block title="Interface" name="adealer_ui">
                            <setting string="Branded theme + side menu (sidebar)" help="3A-dealer branded theme (navy/gold) and the classic left side menu. On by default.">
                                <field name="adealer_sidebar_enabled"/>
                            </setting>
                            <setting string="Brand logo instead of photo" help="Show the brand logo as the vehicle image by default">
                                <field name="adealer_brand_logo_default"/>
                            </setting>
                            <setting string="Interface language" help="Interface language for the current user">
                                <field name="adealer_lang"/>
                            </setting>
                            <setting string="Home page" help="What to open after login for the current user: workshop — calendar, showroom — vehicles, manager — reports">
                                <field name="adealer_home"/>
                            </setting>
                            <setting string="Dashboard tab on open" help="Which tab of the Home dashboard opens first: a workshop wants Service, a showroom wants Showroom.">
                                <field name="adealer_dashboard_tab"/>
                            </setting>
                            <setting string="Printable form format" help="HTML — the form opens in a browser tab (no Adobe/download). PDF — a file is downloaded.">
                                <field name="adealer_print_format"/>
                            </setting>
                            <setting string="Auto-invoice when the repair order is done" help="When a repair order moves to 'Repaired', automatically create Act+Delivery note. Off — via buttons.">
                                <field name="adealer_autopost_docs"/>
                            </setting>
                            <setting string="Show add-on hints" help="A short note on the vehicle, repair-order and part forms about what the paid 3A-dealer add-ons would add there. Each hint disappears by itself once that add-on is installed.">
                                <field name="adealer_addon_hints"/>
                            </setting>
                        </block>
                        <block title="Menu sections (show)" name="adealer_menu_sections">
                            <setting string="Vehicles and models"><field name="show_menu_vehicles"/></setting>
                            <setting string="Showroom"><field name="show_menu_showroom"/></setting>
                            <setting string="Products and services"><field name="show_menu_products"/></setting>
                            <setting string="Partners and users"><field name="show_menu_contacts"/></setting>
                            <setting string="Maintenance and repair"><field name="show_menu_maintenance"/></setting>
                            <setting string="Sales"><field name="show_menu_sales"/></setting>
                            <setting string="Purchases"><field name="show_menu_purchases"/></setting>
                            <setting string="Reports"><field name="show_menu_reports"/></setting>
                        </block>
                        <block title="Error reports" name="adealer_error_reports_block">
                            <setting string="Automatic error reports"
                                     help="Off by default. When on, an unexpected failure sends a report — the error type and the line of code, never the text and nothing about your vehicles, customers or amounts. Read every queued report before it leaves.">
                                <field name="adealer_error_reports" widget="radio"/>
                                <div class="mt8 text-muted" invisible="adealer_error_reports != 'on'">
                                    Queued reports: Settings menu -> Error reports.
                                </div>
                            </setting>
                            <setting string="Reporting endpoint"
                                     help="Where reports are sent. Point it at your own collector if your policy forbids outbound calls to third parties.">
                                <field name="adealer_report_url"/>
                            </setting>
                        </block>
                        <block title="Updates" name="adealer_updates">
                            <setting string="Application version"
                                     help="Installed vs. the latest published version">
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label for="adealer_version_installed" string="Installed" class="col-lg-3 o_light_label"/>
                                        <field name="adealer_version_installed" readonly="1"/>
                                    </div>
                                    <div class="row">
                                        <label for="adealer_version_latest" string="Latest" class="col-lg-3 o_light_label"/>
                                        <field name="adealer_version_latest" readonly="1"/>
                                    </div>
                                    <div class="row">
                                        <label for="adealer_version_checked" string="Checked" class="col-lg-3 o_light_label"/>
                                        <field name="adealer_version_checked" readonly="1"/>
                                    </div>
                                    <div class="mt8">
                                        <button name="action_adealer_check_update" type="object"
                                                string="Check now" class="btn-primary"/>
                                        <button name="action_adealer_update_from_git" type="object"
                                                string="Update from GitHub" class="btn-secondary ms-2"
                                                invisible="not adealer_update_available"
                                                confirm="Pull the latest code from GitHub and upgrade the module?"/>
                                        <field name="adealer_update_available" invisible="1"/>
                                    </div>
                                </div>
                            </setting>
                            <setting string="Paid add-ons"
                                     help="Odoo never asks the store whether a third-party module was updated, so without this a published fix would go unnoticed. Checked once a day, together with the core module. Nothing is downloaded or installed automatically.">
                                <div class="mt8">
                                    <field name="adealer_addons_status" readonly="1" nolabel="1"/>
                                </div>
                            </setting>
                            <setting string="Update check URL"
                                     help="URL used to read the latest published version">
                                <field name="adealer_update_channel_url"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="adealer.action_window_config_settings">
            <field name="name">3A-dealer settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'adealer'}</field>
        </record>

        <!-- Menu Configuration -->
        <menuitem name="Settings" id="adealer.configuration" parent="adealer.menu_root" sequence="99"/>
        <menuitem name="Parameters" id="adealer.settings" parent="adealer.configuration" action="adealer.action_window_config_settings" sequence="91"/>

    </data>
</odoo>
