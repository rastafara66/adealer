<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.adealer</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="90"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="3A-dealer" string="3A-dealer" name="adealer">
                        <block title="Інтерфейс" name="adealer_ui">
                            <setting string="Фірмова тема + бічне меню (сайдбар)" help="Фірмова тема 3A-dealer (navy/gold) та ліве бічне меню у стилі 1С. Увімкнено за замовчуванням.">
                                <field name="adealer_sidebar_enabled"/>
                            </setting>
                            <setting string="Лого бренда замість фото" help="Показувати лого бренда як зображення авто за замовчуванням">
                                <field name="adealer_brand_logo_default"/>
                            </setting>
                            <setting string="Мова інтерфейсу" help="Мова інтерфейсу для поточного користувача">
                                <field name="adealer_lang"/>
                            </setting>
                            <setting string="Стартова сторінка" help="Що відкривати після входу для поточного користувача: СТО — календар, автосалон — автомобілі, менеджер — звіти">
                                <field name="adealer_home"/>
                            </setting>
                            <setting string="Формат друкованих форм" help="HTML — форма відкривається у вкладці браузера (без Adobe/завантаження). PDF — завантажується файл.">
                                <field name="adealer_print_format"/>
                            </setting>
                            <setting string="Авто-реалізація при проведенні наряду" help="При переході наряду у «Відремонтовано» автоматично створювати Акт+Видаткову. Вимкнено — кнопками.">
                                <field name="adealer_autopost_docs"/>
                            </setting>
                        </block>
                        <block title="Розділи меню (показувати)" name="adealer_menu_sections">
                            <setting string="Автомобілі та моделі"><field name="show_menu_vehicles"/></setting>
                            <setting string="Автосалон"><field name="show_menu_showroom"/></setting>
                            <setting string="Товари та послуги"><field name="show_menu_products"/></setting>
                            <setting string="Партнери та користувачі"><field name="show_menu_contacts"/></setting>
                            <setting string="Обслуговування та ремонт"><field name="show_menu_maintenance"/></setting>
                            <setting string="Продажі"><field name="show_menu_sales"/></setting>
                            <setting string="Закупівлі"><field name="show_menu_purchases"/></setting>
                            <setting string="Звіти"><field name="show_menu_reports"/></setting>
                        </block>
                        <block title="Warehouses" name="adealer_warehouses">
                            <setting string="WareHouse ID 3A">
                                <field name="wh_id_3a"/>
                            </setting>
                            <setting string="WareHouse ID 1C">
                                <field name="wh_id_1c"/>
                            </setting>
                            <setting string="WareHouse Name 3A">
                                <field name="wh_name_3a"/>
                            </setting>
                            <setting string="WareHouse Name 1C">
                                <field name="wh_name_1c"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.act_window" id="adealer.action_window_config_settings">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">current</field>
            <field name="context">{'module' : 'adealer'}</field>
        </record>

        <!-- Menu Configuration -->
        <menuitem name="Налаштування" id="adealer.configuration" parent="adealer.menu_root" sequence="99"/>
        <menuitem name="Параметри" id="adealer.settings" parent="adealer.configuration" action="adealer.action_window_config_settings" sequence="91"/>

    </data>
</odoo>
