<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Сканер штрихкодів: віджет нічого не малює, лише слухає сканер і віддає
         код у `on_barcode_scanned` (models/barcode_scan.py). 🔴 Без invisible:
         невидиме поле Odoo не монтує, і віджет не чує сканера. -->
    <record id="sale_order_form_barcode_scan" model="ir.ui.view">
        <field name="name">sale.order.form.barcode.scan.adealer</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="_barcode_scanned" widget="barcode_handler"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_form_barcode_scan" model="ir.ui.view">
        <field name="name">purchase.order.form.barcode.scan.adealer</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="_barcode_scanned" widget="barcode_handler"/>
            </xpath>
        </field>
    </record>

    <record id="repair_order_form_barcode_scan" model="ir.ui.view">
        <field name="name">repair.order.form.barcode.scan.adealer</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="_barcode_scanned" widget="barcode_handler"/>
            </xpath>
        </field>
    </record>
</odoo>
