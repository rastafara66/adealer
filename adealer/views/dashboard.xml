<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Дашборд «Головна» — OWL client action (перемикач типів + період) -->
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Home</field>
        <field name="tag">adealer_dashboard</field>
    </record>

    <!-- Найперший пункт застосунку (sequence 0, раніше за menu_vehicles=1) → стартова -->
    <menuitem name="Home" id="menu_dashboard" parent="adealer.menu_root"
              action="adealer.action_dashboard" sequence="0"/>
</odoo>
