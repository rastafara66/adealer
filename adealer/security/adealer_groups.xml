<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ⚠️ Під'єднання цих груп до штатних (`base.group_user` /
         `base.group_system`) живе в `adealer_groups_wiring.xml` — БЕЗ
         `noupdate`. Тут воно не працювало б при оновленні наявної бази. -->

    <!-- 🔴 ВЛАСНІ ГРУПИ. Досвід власника 09.09.2026: «про права — найчастіша
         помилка в Odoo: ти основній групі юзерів даєш права на нові моделі,
         що створюєш. Я сто разів на цьому ламався».

         Так було й тут: усі 31 модель модуля відкривались `base.group_user` —
         тобто КОЖНОМУ внутрішньому користувачеві Odoo, включно з тими, хто до
         автосалону стосунку не має. І не лише на читання: на зміну й
         видалення теж.

         ⚠️ Помилка не має симптомів у той бік, у який дивляться. Розробник
         перевіряє «чи відкривається» — і воно відкривається, навіть краще,
         ніж треба. Що зайвий користувач ПРАВИТЬ чужі дані, не покаже ні тест
         (§7: тести йдуть під superuser), ні встановлення, ні збірка.

         Дві групи, як робить сама Odoo для своїх застосунків:

         * **Користувач** — той, хто працює щодня: приймальник, механік,
           продавець, комірник. Веде наряди, записи, авто, кампанії.
         * **Керівник** — успадковує користувача й додає те, що міняє правила
           гри для всіх: довідники, налаштування, імпорти, звіти по грошах.

         Керівник УСПАДКОВУЄ користувача (`implied_ids`), тож права не треба
         видавати двічі — інакше вони неминуче розійдуться. -->

    <!-- 🔴 ODOO 19: у групи НЕМАЄ `category_id`. З'явився проміжний рівень —
         `res.groups.privilege`: група посилається на привілей, а привілей на
         категорію модуля. У 17-й і 18-й було `category_id` просто на групі.

         Перша редакція цього файла була написана «як завжди», і встановлення
         впало з `ParseError` на самому записі групи — без слова про поле,
         якого не існує. Різниця вже записана в PITFALLS §3, рядок «Групи
         прав»; я в неї все одно вступив. -->
    <record id="module_category_adealer" model="ir.module.category">
        <field name="name">3A-dealer</field>
        <field name="description">Автосалон, СТО, запчастини</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_adealer" model="res.groups.privilege">
        <field name="name">3A-dealer</field>
        <field name="category_id" ref="module_category_adealer"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_adealer_user" model="res.groups">
        <field name="name">Користувач</field>
        <field name="privilege_id" ref="privilege_adealer"/>
        <field name="comment">Щоденна робота: наряди, записи на сервіс, авто
            клієнтів, склад авто, кампанії. Без довідників і налаштувань.</field>
    </record>

    <!-- 🔴 ПРАЦЮЄ ОДРАЗУ, БЕЗ ЖОДНИХ ДІЙ. Вимога власника 09.09.2026:
         «головне — щоб працювало одразу!».

         Кожен внутрішній користувач автоматично отримує рівень «Користувач».
         Без цього після встановлення модуль виглядав би ЗЛАМАНИМ: меню є,
         нічого не відкривається, і причина нізвідки не видна — а покупець
         про потребу роздати групи не знає й знати не мусить. Те саме
         стосується користувачів, створених ПІЗНІШЕ: вони теж отримають
         доступ самі, бо `base.group_user` має його кожен співробітник.

         ⚠️ І це НЕ повернення до старого. Раніше `base.group_user` мала
         повні права на всі 31 модель, включно з довідниками, імпортами й
         звітами по грошах. Тепер автоматично видається лише щоденна робота;
         те, що змінює правила для всіх, лишилось за керівником, і його
         видають свідомо. -->

    <record id="group_adealer_manager" model="res.groups">
        <field name="name">Керівник</field>
        <field name="privilege_id" ref="privilege_adealer"/>
        <!-- ⚠️ Успадкування, а не другий набір прав: інакше два переліки
             розійдуться на першій же правці, і керівник почне втрачати те,
             що є в користувача. -->
        <field name="implied_ids" eval="[(4, ref('group_adealer_user'))]"/>
        <field name="comment">Усе, що вміє користувач, плюс довідники,
            налаштування, імпорти й звіти по взаєморозрахунках.</field>
    </record>

    <!-- 🔴 АДМІНІСТРАТОР ОТРИМУЄ КЕРІВНИЦЬКИЙ РІВЕНЬ ОДРАЗУ.
         Хто адмініструє систему, той і налаштовує додаток — інакше після
         встановлення нікому буде відкрити довідники, і модуль виглядав би
         недоробленим.

         ⚠️ Робимо це успадкуванням від `base.group_system`, а НЕ переліком
         користувачів на групі. Перша редакція писала
         `<field name="users" eval="[(4, ref('base.user_admin'))]"/>` — і
         встановлення впало: в Odoo 19 у `res.groups` поля `users` більше
         немає. Успадкування від системної групи не залежить від того, як
         цього року зветься поле користувачів, і працює для БУДЬ-ЯКОГО
         адміністратора, а не лише для того одного запису, який ми назвали. -->

</odoo>
