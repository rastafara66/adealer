<!-- 🔴 БЕЗ `noupdate` — І ЦЕ ГОЛОВНЕ В ЦЬОМУ ФАЙЛІ.

     Самі групи оголошені в `adealer_groups.xml` під `noupdate="1"`: там це
     правильно, бо адміністратор міг перейменувати групу чи додати до неї
     людей, і оновлення не має цього затирати.

     Але під `noupdate="1"` потрапило й ПІД'ЄДНАННЯ наших груп до штатних
     (`base.group_user` -> Користувач, `base.group_system` -> Керівник). А
     `noupdate` означає «не переприкладати при оновленні» — тож у кожній базі,
     яка вже мала модуль ДО появи цих рядків, успадкування не з'явилось
     ніколи.

     Наслідок був такий (10.09.2026, база замовника і наша тестова):

         base.group_user implies adealer_user:   False
         base.group_system implies adealer_mgr:  False

     а користувач бачив «Помилка доступу: у вас немає доступу до записів
     «Рядок наряду» (repair.line)» на кожному документі. Меню на місці, дані
     на місці, модуль «встановлено» — і нічого не відкривається.

     ⚠️ На ЧИСТОМУ встановленні все працювало, тому помилки не було видно
     звідти, звідки на неї дивляться: `-i` у порожню базу проходив бездоганно.
     Ламалось лише ОНОВЛЕННЯ — тобто рівно те, що робить кожен наявний
     покупець.

     Власник, 10.09.2026: «це НАЙПОШИРЕНІША помилка всіх додатків в магазині»,
     «треба — встановив і ВСЕ працює», «встановляє зазвичай адмін, не
     бухгалтер».

     Записи нижче ідемпотентні: `(4, ref(...))` додає зв'язок, якщо його
     немає, і нічого не робить, якщо він уже є. -->
<odoo>

    <!-- Кожен внутрішній користувач — рівень «Користувач»: щоденна робота. -->
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('adealer.group_adealer_user'))]"/>
    </record>

    <!-- Адміністратор — рівень «Керівник»: він і ставить додаток. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('adealer.group_adealer_manager'))]"/>
    </record>

    <!-- 🔴 НАШ «Користувач» УСПАДКОВУЄ ШТАТНІ ГРУПИ ТИХ ДОДАТКІВ, МЕНЮ ЯКИХ
         МИ ПОКАЗУЄМО. 3A-dealer — парасолька над Складом, Продажами,
         Закупівлями, Складом, Автопарком і Рахунками; меню наші, а права на
         самі моделі дають ЧУЖІ групи.

         Зміряно 10.09.2026 на живій базі: із 52 моделей, до яких ведуть наші
         меню, звичайний співробітник не міг відкрити **35**. Наряд-замовлення
         в тому числі — тобто головний документ додатка.

         ⚠️ Це не «роздати все всім»: беремо рівень КОРИСТУВАЧА кожного
         штатного додатка, не менеджера. Налаштування, довідники й майстри
         лишаються за керівником. -->
    <record id="group_adealer_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman')),
                                         (4, ref('purchase.group_purchase_user')),
                                         (4, ref('stock.group_stock_user')),
                                         (4, ref('fleet.fleet_group_user')),
                                         (4, ref('account.group_account_invoice'))]"/>
    </record>

</odoo>
